---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import PostHeader from '../../../components/PostHeader.astro';
import BackToTop from '../../../components/BackToTop.astro';
import MissingTranslationNotice from '../../../components/MissingTranslationNotice.astro';
import TableOfContents from '../../../components/TableOfContents.astro';
import PostNav from '../../../components/PostNav.astro';
import { getAdjacentPosts } from '../../../utils/postLinks';
import { calculateReadingTime, formatReadingTime } from '../../../utils/reading-time';
import { buildMarkdownUrl, getPostRoutes, getPublishedPosts } from '../../../utils/publishedPosts';

export async function getStaticPaths() {
  const all = await getPublishedPosts();
  return getPostRoutes(all).filter(({ lang }) => lang === 'en').map(({ post }) => ({
    params: { translationSlug: post.data.translationSlug },
    props: { post, counterpart: all.find((other) => other.data.lang === 'zh-CN'
      && other.data.translationSlug === post.data.translationSlug) },
  }));
}

const { translationSlug } = Astro.params;
const { post, counterpart } = Astro.props;
const isFallback = post.data.lang !== 'en';
const markdownUrl = buildMarkdownUrl(translationSlug!, 'en');
const { Content } = await post.render();
const { older, newer } = await getAdjacentPosts(translationSlug, 'en');
const readingTime = formatReadingTime(calculateReadingTime(post.body), 'en');

// Check if post is in a folder
const isInFolder = translationSlug.includes('/');
const parentFolderPath = isInFolder ? translationSlug.substring(0, translationSlug.lastIndexOf('/')) : null;

const alternates = {
  en: new URL(`/en/posts/${translationSlug}/`, Astro.site ?? 'https://blog.konakona.dev/').href,
  ...(counterpart ? { 'zh-CN': new URL(`/zh/posts/${translationSlug}/`, Astro.site ?? 'https://blog.konakona.dev/').href } : {})
};

const ogImageUrl = new URL(`/og/${isFallback ? '' : 'en-'}${translationSlug}.png`, Astro.site ?? 'https://blog.konakona.dev/').href;
---

<Layout lang="en" title={post.data.title} description={post.data.description} alternates={alternates} ogImage={ogImageUrl} markdownUrl={markdownUrl}>
  <Header
    lang="en"
    disableZh={!counterpart}
    toZh={counterpart ? `/zh/posts/${translationSlug}/` : '/zh/'}
    toEn={`/en/posts/${translationSlug}/`}
  />
  <main id="main-content" tabindex="-1">
    <article>
      {parentFolderPath && (
        <nav class="parent-folder-nav animate">
          <a href={`/en/folders/${parentFolderPath}/`} class="back-to-folder">
            ← Back to folder
          </a>
        </nav>
      )}
      <div class="animate">
        <PostHeader title={post.data.title} description={post.data.description} date={post.data.date} lang={isFallback ? 'zh-CN' : 'en'} readingTime={readingTime} markdownUrl={markdownUrl} uiLang="en" />
      </div>
      {isFallback && <MissingTranslationNotice lang="en" translationUrl={`/zh/posts/${translationSlug}/`} />}
      <div class="prose animate">
        <Content />
      </div>
      <p class="post-end" aria-hidden="true">see you next time ~</p>
      <PostNav lang="en" older={older} newer={newer} />
    </article>
  </main>
  <TableOfContents lang="en" />
  <BackToTop lang="en" />
</Layout>

<style>
  .parent-folder-nav {
    margin-bottom: 1.5rem;
  }

  .back-to-folder {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.95rem;
    transition: color 0.2s;
  }

  .back-to-folder:hover {
    color: var(--link);
  }

  .prose {
    margin-top: 2rem;
  }

  .post-end {
    margin: 3rem 0 0;
    text-align: right;
    font: 400 1.4rem/1 var(--font-hand);
    color: var(--seal);
    transform: rotate(-3deg);
    transition: color 0.3s ease-in-out;
  }
</style>
