---
import { SITE } from '../site.config';
import Footer from '../components/Footer.astro';
import Toast from '../components/Toast.astro';
import en from '../i18n/en.json';
import zh from '../i18n/zh.json';

import '@fontsource/inter/400.css';
import '@fontsource/inter/600.css';
import '@fontsource/lora/400.css';
import '@fontsource/lora/600.css';

import inter400 from '@fontsource/inter/files/inter-latin-400-normal.woff2';
import inter600 from '@fontsource/inter/files/inter-latin-600-normal.woff2';
import lora400 from '@fontsource/lora/files/lora-latin-400-normal.woff2';
import lora600 from '@fontsource/lora/files/lora-latin-600-normal.woff2';

export interface Props {
  lang: 'zh-CN' | 'en';
  title?: string;
  description?: string;
  canonical?: string;
  alternates?: { 'zh-CN'?: string; en?: string };
  ogImage?: string;
}
const { lang, title, description, canonical, alternates, ogImage } = Astro.props as Props;
const site = SITE.domain;
const current = canonical || Astro.url.toString();
const pageTitle = title || SITE.title;
const strings = lang === 'zh-CN' ? zh : en;
---
<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon-dark.svg" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon-light.svg" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/svg+xml" href="/favicon-light.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Font preloads -->
    <link rel="preload" href={inter400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={inter600} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={lora400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={lora600} as="font" type="font/woff2" crossorigin />
    
    <!-- KaTeX CSS for math rendering -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" crossorigin="anonymous" />
    
    <script is:inline>
      // Apply saved theme immediately to prevent flash
      (function() {
        const savedTheme = localStorage.getItem('theme');
        if (savedTheme === 'light') {
          document.documentElement.setAttribute('data-theme', 'light');
        } else if (savedTheme === 'dark') {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
        // 'auto' or no saved theme = no attribute, uses prefers-color-scheme
      })();
    </script>
    
    <script is:inline src="/scripts/main.js" defer></script>
    <script is:inline src="/scripts/code-copy.js" defer></script>
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={current} />
    {alternates?.['zh-CN'] && <link rel="alternate" hreflang="zh-CN" href={alternates['zh-CN']} />}
    {alternates?.en && <link rel="alternate" hreflang="en" href={alternates.en} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description || ''} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={current} />
    <meta property="og:image" content={ogImage || new URL(`/og/${Astro.params.slug || 'site'}.svg`, site).href} />
    <meta property="og:locale" content={lang === 'zh-CN' ? 'zh_CN' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'zh-CN' ? 'en_US' : 'zh_CN'} />
    <meta name="twitter:card" content="summary_large_image" />
    <style is:global>
      :root {
        color-scheme: light dark;
        --header-offset: 5rem; /* sync with restored header height */
      }
      
      :root,
      :root[data-theme="light"] {
        --text: #292524;
        --text-muted: #78716c;
        --bg: #fafaf9;
        --link: #2563eb;
        --border: #e7e5e4;
        --code-bg: #f5f5f4;
        --code-block-bg: #f6f8fa;
        --code-block-header-bg: #eef1f4;
        --code-block-border: #d8dee4;
        --code-inline-bg: #dbeafe;
        --code-inline-text: #1e3a8a;
        --font-family: "Lora", "Georgia", serif;
        --font-heading: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      }
      
      :root[lang="zh-CN"],
      :root[lang="zh-CN"][data-theme="light"] {
        --font-family: "Inter", -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
        --font-heading: "Inter", -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
      }
      
      :root[data-theme="dark"] {
        color-scheme: dark;
        --text: #d6d3d1;
        --text-muted: #a8a29e;
        --bg: #1c1917;
        --link: #60a5fa;
        --border: #292524;
        --code-bg: #292524;
        --code-block-bg: #24292e;
        --code-block-header-bg: #292e33;
        --code-block-border: #3b4148;
        --code-inline-bg: #1e293b;
        --code-inline-text: #93c5fd;
      }
      
      :root[lang="zh-CN"][data-theme="dark"] {
        --font-family: "Inter", -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
        --font-heading: "Inter", -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
      }
      
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme]) {
          --text: #d6d3d1;
          --text-muted: #a8a29e;
          --bg: #1c1917;
          --link: #60a5fa;
          --border: #292524;
          --code-bg: #292524;
          --code-block-bg: #24292e;
          --code-block-header-bg: #292e33;
          --code-block-border: #3b4148;
          --code-inline-bg: #1e293b;
          --code-inline-text: #93c5fd;
        }
        
        :root[lang="zh-CN"]:not([data-theme]) {
          --font-family: "Inter", -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
          --font-heading: "Inter", -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
        }
      }
      * { box-sizing: border-box; }
      
      html {
        height: 100%;
        overflow-y: scroll; /* Always show scrollbar */
      }
      
      body {
        height: 100%;
      }
      
      body {
        max-width: 45rem;
        margin: 0 auto;
        padding: 0 1rem 0;
        line-height: 1.6;
        font-family: var(--font-family);
        color: var(--text);
        background: var(--bg);
        font-size: 16px;
        transition: color 0.3s ease-in-out, background 0.3s ease-in-out;
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }
      a {
        color: var(--link);
        text-decoration: none;
        transition: color 0.2s ease-in-out;
      }
      a:hover {
        text-decoration: underline;
      }
      
      .content {
        flex: 1;
        padding: var(--header-offset) 0 2rem;
      }
      
      h1, h2, h3, h4, h5, h6 {
        line-height: 1.2;
        margin: 2rem 0 1rem;
        font-weight: 600;
        font-family: var(--font-heading);
        transition: color 0.3s ease-in-out;
      }
      h1 { font-size: 1.75rem; margin-top: 0; }
      h2 { font-size: 1.35rem; }
      h3 { font-size: 1.15rem; }
      p { margin: 1rem 0; }
      ul, ol { padding-left: 1.5rem; margin: 1rem 0; }
      li { margin: 0.5rem 0; }
      code {
        font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
        font-size: 0.9em;
        background: var(--code-inline-bg);
        color: var(--code-inline-text);
        padding: 0.2em 0.4em;
        border-radius: 3px;
        -webkit-box-decoration-break: clone;
        box-decoration-break: clone;
        transition: background 0.3s ease-in-out, color 0.3s ease-in-out;
      }

      .prose code[data-copyable-inline="true"]:hover {
        background: color-mix(in srgb, var(--code-inline-bg) 92%, var(--link));
      }

      .prose code[data-copyable-inline="true"] {
        cursor: copy;
        outline: none;
      }

      /* Hide MathML (screen readers only) - backup if KaTeX CSS fails */
      .katex-mathml {
        position: absolute;
        clip: rect(1px, 1px, 1px, 1px);
        padding: 0;
        border: 0;
        height: 1px;
        width: 1px;
        overflow: hidden;
      }
      pre {
        background: var(--code-bg);
        padding: 0.75rem;
        border-radius: 6px;
        overflow-x: auto;
        margin: 1rem 0;
        transition: background 0.3s ease-in-out;
      }
      pre code {
        background: none;
        color: inherit;
        padding: 0;
      }

      .code-block {
        margin: 1rem 0;
        border-radius: 8px;
        overflow: hidden;
        background: var(--code-block-bg);
        transition: background-color 0.3s ease-in-out, border-color 0.3s ease-in-out;
      }

      .code-block-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        min-height: 1.8rem;
        padding: 0.2rem 0.4rem 0.2rem 0.65rem;
        border-bottom: 1px solid var(--code-block-border);
        background: var(--code-block-header-bg);
        transition: color 0.3s ease-in-out, background-color 0.3s ease-in-out, border-color 0.3s ease-in-out;
      }

      .code-block-language {
        color: var(--text-muted);
        font: 600 0.65rem/1 ui-monospace, SFMono-Regular, Consolas, monospace;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        transition: color 0.3s ease-in-out;
      }

      .code-block pre {
        margin: 0;
        border-radius: 0 0 8px 8px;
      }

      .astro-code,
      .astro-code span {
        color: var(--shiki-light);
      }

      .astro-code {
        background-color: var(--code-block-bg) !important;
      }

      :root[data-theme="dark"] .astro-code,
      :root[data-theme="dark"] .astro-code span {
        color: var(--shiki-dark);
      }

      :root[data-theme="dark"] .astro-code {
        background-color: var(--shiki-dark-bg) !important;
      }

      @media (prefers-color-scheme: dark) {
        :root:not([data-theme]) .astro-code,
        :root:not([data-theme]) .astro-code span {
          color: var(--shiki-dark);
        }

        :root:not([data-theme]) .astro-code {
          background-color: var(--shiki-dark-bg) !important;
        }
      }

      .code-block-copy {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        min-height: 1.4rem;
        padding: 0.15rem 0.3rem;
        border: 0;
        border-radius: 0.3rem;
        background: transparent;
        color: var(--text-muted);
        font: 600 0.6875rem/1 var(--font-heading);
        cursor: pointer;
        transition: color 0.3s ease-in-out, background-color 0.3s ease-in-out, border-color 0.3s ease-in-out;
      }

      .code-block-copy:hover {
        background: color-mix(in srgb, var(--bg) 58%, transparent);
        color: var(--text);
      }

      .code-block-copy:focus-visible {
        outline: 2px solid var(--link);
        outline-offset: 2px;
      }

      .code-block-copy svg {
        width: 0.8rem;
        height: 0.8rem;
        fill: none;
        stroke: currentColor;
        stroke-linecap: round;
        stroke-linejoin: round;
        stroke-width: 1.8;
      }

      @media (prefers-reduced-motion: reduce) {
        .code-block-copy {
          transition-duration: 0.01ms;
        }
      }
      hr {
        border: none;
        border-top: 1px solid var(--border);
        margin: 2rem 0;
        transition: border-color 0.3s ease-in-out;
      }
      blockquote {
        border-left: 3px solid var(--border);
        padding-left: 1rem;
        margin: 1rem 0;
        color: var(--text-muted);
        transition: border-color 0.3s ease-in-out, color 0.3s ease-in-out;
      }

      .prose table {
        width: 100%;
        max-width: 100%;
        margin: 1.5rem 0;
        border: 1px solid var(--border);
        border-radius: 0.75rem;
        border-collapse: separate;
        border-spacing: 0;
        overflow: hidden;
        background: var(--bg);
        box-shadow: 0 1px 2px color-mix(in srgb, var(--text) 6%, transparent);
        font-family: var(--font-heading);
        font-size: 0.925rem;
        line-height: 1.5;
        transition: background 0.3s ease-in-out, border-color 0.3s ease-in-out, box-shadow 0.3s ease-in-out;
      }

      .prose th,
      .prose td {
        padding: 0.7rem 0.85rem;
        border-bottom: 1px solid var(--border);
        text-align: left;
        vertical-align: top;
        transition: color 0.3s ease-in-out, background 0.3s ease-in-out, border-color 0.3s ease-in-out;
      }

      .prose th {
        background: color-mix(in srgb, var(--code-bg) 84%, var(--bg));
        font-weight: 600;
      }

      .prose tbody tr:nth-child(even) td {
        background: color-mix(in srgb, var(--code-bg) 36%, transparent);
      }

      .prose tbody tr:last-child td {
        border-bottom: 0;
      }

      .prose th[align="right"],
      .prose td[align="right"] {
        text-align: right;
      }

      .prose table code {
        white-space: nowrap;
      }

      @media (hover: hover) {
        .prose tbody tr:hover td {
          background: color-mix(in srgb, var(--code-bg) 64%, transparent);
        }
      }

      @media (max-width: 40rem) {
        .prose table {
          display: block;
          overflow-x: auto;
          scrollbar-width: thin;
          scrollbar-color: var(--border) transparent;
        }
      }

      .prose img {
        display: block;
        max-width: 100%;
        height: auto;
        margin: 1.5rem auto;
      }
      
      
      /* Staggered fade-in animation (Nano style) */
      .animate {
        opacity: 0;
        transform: translateY(12px);
        transition: opacity 0.6s ease-out, transform 0.6s ease-out;
      }
      
      .animate.show {
        opacity: 1;
        transform: translateY(0);
      }
      /* Universal top spacing below fixed header */
      header + * { margin-top: 1rem; }
    </style>
  </head>
  <body
    data-copy-label={strings.copy_code}
    data-copied-label={strings.copied_code}
    data-copy-failed-label={strings.copy_failed}
  >
    <main class="content">
      <slot />
    </main>
    <Toast />
    <Footer lang={lang} />
  </body>
</html>
