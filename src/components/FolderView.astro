---
import type { FolderStructure } from '../utils/folders';
import TitleWithCount from './TitleWithCount.astro';
import PostTimeline from './PostTimeline.astro';
import { getLocalizedFolderName, getLocalizedFolderDescription } from '../utils/folderMetadata';

interface Props {
  structure: FolderStructure;
  lang: 'zh-CN' | 'en';
  currentPath?: string;
  postLimit?: number;
}

const { structure, lang, currentPath = '', postLimit } = Astro.props;
const baseUrl = lang === 'zh-CN' ? '' : '/en';
const folderBaseUrl = `${baseUrl}/folders`;
const allPostsHref = lang === 'zh-CN' ? '/zh/posts/' : '/en/posts/';
const postCount = structure.posts.length;
const truncated = postLimit !== undefined && postCount > postLimit;

const t = {
  'zh-CN': {
    posts: '文章',
    folders: '文件夹',
    allPosts: `全部 ${postCount} 篇 →`,
    notes: (n: number) => `${n} 篇笔记`,
  },
  'en': {
    posts: 'Posts',
    folders: 'Folders',
    allPosts: `All ${postCount} →`,
    notes: (n: number) => `${n} ${n === 1 ? 'note' : 'notes'}`,
  }
};

const text = t[lang];
---

<div class="folder-view">
  {structure.posts.length > 0 && (
    <section class="posts-section">
      <div class="section-head">
        <h2 class="section-title">
          <TitleWithCount id="section-post-count" title={text.posts} count={postCount} lang={lang} />
        </h2>
        {truncated && <a class="see-all" href={allPostsHref}>{text.allPosts}</a>}
      </div>
      <PostTimeline posts={truncated ? structure.posts.slice(0, postLimit) : structure.posts} lang={lang} />
    </section>
  )}

  <slot name="before-folders" />

  {structure.folders.length > 0 && (
    <section class="folders-section">
      <h2 class="section-title">{text.folders}</h2>
      <ul class="folder-list">
        {structure.folders.map((folder) => {
          const folderDesc = getLocalizedFolderDescription(folder.path, lang);
          return (
            <li class="folder-item">
              <a href={`${folderBaseUrl}/${folder.path}/`} class="folder-link">
                <span class="folder-tab">{text.notes(folder.postCount)}</span>
                <h3 class="folder-name">{getLocalizedFolderName(folder.path, lang)}</h3>
                {folderDesc && <p class="folder-description">{folderDesc}</p>}
              </a>
            </li>
          );
        })}
      </ul>
    </section>
  )}
</div>

<style>
  .folder-view {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .section-title {
    font-size: 1.3rem;
    margin: 0 0 0.25rem 0;
    color: var(--text);
  }

  .see-all {
    font: 400 1rem/1 var(--font-hand);
    white-space: nowrap;
  }

  .section-title :global(.post-count) {
    font: 400 1rem/1 var(--font-hand);
    color: var(--accent);
  }

  /* Folders */
  .folder-list {
    list-style: none;
    padding: 0;
    margin: 1.75rem 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 2.4rem 1.4rem;
  }

  .folder-item {
    margin: 0;
  }

  .folder-link {
    position: relative;
    display: block;
    height: 100%;
    padding: 1.3rem 1.2rem 1.1rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 0 10px 10px 10px;
    text-decoration: none;
    color: inherit;
    transition: transform 0.25s ease, color 0.3s ease-in-out, background-color 0.3s ease-in-out, border-color 0.3s ease-in-out;
  }

  .folder-link:hover {
    text-decoration: none;
    transform: translateY(-3px);
  }

  .folder-tab {
    position: absolute;
    top: -1.55rem;
    left: -1px;
    padding: 0.2rem 0.8rem 0.25rem;
    border-radius: 8px 8px 0 0;
    background: var(--link);
    color: var(--bg);
    font: 400 0.9rem/1.2 var(--font-hand);
    transition: background-color 0.3s ease-in-out, color 0.3s ease-in-out;
  }

  .folder-item:nth-child(even) .folder-tab {
    background: var(--accent);
    color: #3a2a17;
  }

  .folder-name {
    margin: 0;
    font-size: 1.08rem;
    line-height: 1.4;
  }

  .folder-description {
    margin: 0.35rem 0 0;
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--text-muted);
    transition: color 0.3s ease-in-out;
  }

  @media (prefers-reduced-motion: reduce) {
    .folder-link {
      transition: color 0.3s ease-in-out, background-color 0.3s ease-in-out, border-color 0.3s ease-in-out;
    }
  }
</style>
