---
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import PostTimeline from './PostTimeline.astro';
import { getCollection } from 'astro:content';
import { buildFolderStructure } from '../utils/folders';
import { SITE } from '../site.config';
import en from '../i18n/en.json';
import zh from '../i18n/zh.json';

interface Props {
  lang: 'zh-CN' | 'en';
}

const { lang } = Astro.props;
const strings = lang === 'zh-CN' ? zh : en;
const entries = await getCollection('posts', ({ data }) => !data.draft && data.lang === lang);
const { posts } = buildFolderStructure(entries, '');
const countText = (posts.length === 1 ? strings.post_count_one : strings.post_count_other)
  .replace('{count}', String(posts.length));
const description = lang === 'zh-CN' ? 'konakona 的全部文章' : "All posts on konakona's blog";

const alternates = {
  'zh-CN': new URL('/zh/posts/', SITE.domain).href,
  en: new URL('/en/posts/', SITE.domain).href,
};
---

<Layout lang={lang} title={`${strings.posts} · ${SITE.title}`} description={description} alternates={alternates}>
  <Header lang={lang} toZh="/zh/posts/" toEn="/en/posts/" />
  <main id="main-content" tabindex="-1" class="animate">
    <h1>{strings.posts}</h1>
    <p class="posts-count">{countText}</p>
    <PostTimeline posts={posts} lang={lang} />
  </main>
</Layout>

<style>
  h1 {
    margin-top: 1.5rem;
    margin-bottom: 0.25rem;
  }

  .posts-count {
    margin: 0;
    font: 400 1rem/1 var(--font-hand);
    color: var(--text-muted);
    transition: color 0.3s ease-in-out;
  }
</style>
