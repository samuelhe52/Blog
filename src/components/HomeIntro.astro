---
interface Props {
  lang: 'zh-CN' | 'en';
}

const { lang } = Astro.props;
const t = {
  'zh-CN': {
    hi: '嗨！',
    title: '我是 Samuel',
    body: '机器学习研究、Swift，还有偶尔掉进去的 debug 兔子洞。',
    ssh: '也可以在终端里阅读：',
    copy: '点击复制',
    copied: '已复制',
  },
  en: {
    hi: 'hi!',
    title: "I'm Samuel",
    body: 'Machine learning research, Swift, and the occasional debugging rabbit hole.',
    ssh: 'Also available in your terminal:',
    copy: 'Click to copy',
    copied: 'Copied',
  },
}[lang];
const sshCommand = 'ssh -p 2222 ssh-blog.konakona.dev';
---

<section class="intro">
  <span class="hi" aria-hidden="true">{t.hi}</span>
  <p class="intro-title">{t.title}</p>
  <p class="intro-body">{t.body}</p>
  <p class="intro-ssh">
    {t.ssh}
    <button type="button" class="ssh-copy" data-ssh-command={sshCommand} data-copied-label={t.copied} title={t.copy}>{sshCommand}</button>
  </p>
</section>

<style>
  .intro {
    position: relative;
    margin: 1.5rem 0 3.5rem;
    padding: 1.9rem 2rem 1.6rem;
    background: var(--note);
    border-radius: 2px 2px 14px 2px;
    box-shadow: 0 1px 0 rgba(0, 0, 0, 0.04), 0 14px 28px -18px rgba(90, 60, 20, 0.45);
    transform: rotate(-0.8deg);
    transition: background-color 0.3s ease-in-out, color 0.3s ease-in-out;
  }

  .intro::before {
    content: "";
    position: absolute;
    top: -0.75rem;
    left: 50%;
    width: 7rem;
    height: 1.6rem;
    transform: translateX(-50%) rotate(2deg);
    background: repeating-linear-gradient(45deg, rgba(233, 163, 94, 0.55) 0 6px, rgba(233, 163, 94, 0.4) 6px 12px);
  }

  .hi {
    position: absolute;
    top: -1.1rem;
    right: 1.4rem;
    font: 400 1.6rem/1 var(--font-hand);
    color: var(--seal);
    transform: rotate(8deg);
    transition: color 0.3s ease-in-out;
  }

  .intro-title {
    margin: 0 0 0.5rem;
    font: 400 2rem/1.25 var(--font-display);
  }

  .intro-body {
    margin: 0;
    color: var(--text-muted);
    transition: color 0.3s ease-in-out;
  }

  .intro-ssh {
    margin: 0.9rem 0 0;
    color: var(--text-muted);
    font-size: 0.8rem;
    transition: color 0.3s ease-in-out;
  }

  .ssh-copy {
    padding: 0.1rem 0.4rem;
    border: 0;
    border-radius: 4px;
    background: var(--code-inline-bg);
    color: var(--code-inline-text);
    font: 0.78rem/1.4 ui-monospace, SFMono-Regular, Consolas, monospace;
    cursor: pointer;
    transition: color 0.3s ease-in-out, background-color 0.3s ease-in-out;
  }

  .ssh-copy:hover,
  .ssh-copy:focus-visible {
    color: var(--link);
  }

  @media (max-width: 640px) {
    .intro {
      padding: 1.6rem 1.4rem 1.4rem;
      transform: rotate(-0.5deg);
    }

    .intro-title {
      font-size: 1.7rem;
    }
  }
</style>
