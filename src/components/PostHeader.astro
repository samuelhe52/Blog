---
import en from '../i18n/en.json';
import zh from '../i18n/zh.json';

interface Props {
  title: string;
  description?: string;
  date?: Date;
  lang: 'zh-CN' | 'en';
  readingTime?: string;
  markdownUrl?: string;
  uiLang?: 'zh-CN' | 'en';
}

const { title, description, date, lang, readingTime, markdownUrl, uiLang = lang } = Astro.props;
const strings = uiLang === 'zh-CN' ? zh : en;
---

<div class="post-header">
  <h1>{title}</h1>
  {date && (
    <div class="meta">
      <time datetime={date.toISOString()}>
        {date.toLocaleDateString(lang === 'zh-CN' ? 'zh-CN' : 'en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
      </time>
      {readingTime && <span aria-hidden="true">·</span>}
      {readingTime && <span>{readingTime}</span>}
      {markdownUrl && <span aria-hidden="true">·</span>}
      {markdownUrl && <a class="markdown-link" href={markdownUrl} type="text/markdown">{strings.view_markdown}</a>}
    </div>
  )}
  {description && <p class="description">{description}</p>}
</div>

<style>
  .post-header {
    display: flex;
    flex-direction: column;
    margin-bottom: 2.25rem;
  }
  h1 {
    margin: 0.6rem 0 0.9rem;
    font-size: clamp(2rem, 5.5vw, 2.6rem);
    line-height: 1.2;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    align-items: center;
    order: -1;
    font: 400 1.05rem/1 var(--font-hand);
    color: var(--text-muted);
    transition: color 0.3s ease-in-out;
  }
  .meta span:last-child {
    color: var(--link);
    transition: color 0.3s ease-in-out;
  }
  .description {
    margin: 0;
    color: var(--text-muted);
    font-size: 1.12rem;
    transition: color 0.3s ease-in-out;
  }
  .markdown-link {
    color: var(--text-muted);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    transition: color 0.3s ease-in-out, background 0.3s ease-in-out, border-color 0.3s ease-in-out;
  }
  .markdown-link:hover {
    color: var(--link);
  }
</style>
