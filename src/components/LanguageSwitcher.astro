---
interface Props {
  lang: 'zh-CN' | 'en';
  disableZh?: boolean;
  disableEn?: boolean;
  toZh?: string;
  toEn?: string;
}
const { lang, disableZh = false, disableEn = false, toZh = '/zh/', toEn = '/en/' } = Astro.props;
const label = lang === 'zh-CN' ? '切换语言' : 'Switch language';
const unavailableLabel = lang === 'zh-CN' ? '暂无该语言版本' : 'Not available in this language';

const options = [
  { code: 'zh-CN', label: '中文', href: toZh, disabled: disableZh },
  { code: 'en', label: 'English', href: toEn, disabled: disableEn },
] as const;
---
<nav class="language-switcher" aria-label={label}>
  {options.map((option) =>
    option.code === lang ? (
      <span class="lang-btn active" lang={option.code} aria-current="page">{option.label}</span>
    ) : option.disabled ? (
      <span class="lang-btn unavailable" lang={option.code} aria-disabled="true" title={unavailableLabel}>{option.label}</span>
    ) : (
      <a class="lang-btn" href={option.href} lang={option.code} hreflang={option.code}>{option.label}</a>
    )
  )}
</nav>

<style>
  .language-switcher {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }
  .lang-btn {
    padding: 0.375rem 0.75rem;
    border-radius: 6px;
    color: var(--text-muted);
    font-size: 0.875rem;
    font-weight: 500;
    font-family: var(--font-family);
    line-height: 1.6;
    text-decoration: none;
    transition: color 0.2s ease-in-out, background 0.2s ease-in-out;
  }
  a.lang-btn:hover {
    background: var(--code-bg);
    color: var(--text);
    text-decoration: none;
  }
  .lang-btn.active {
    background: var(--link);
    color: white;
  }
  .lang-btn.unavailable {
    opacity: 0.4;
    cursor: not-allowed;
    text-decoration: line-through;
  }
</style>
